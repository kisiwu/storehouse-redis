{
  "name": "@storehouse/redis",
  "version": "0.1.0",
  "description": "Redis manager for @storehouse/core",
  "main": "lib/index.js",
  "scripts": {
    "build": "pnpm exec tsc",
    "format": "cross-env NODE_OPTIONS=--experimental-strip-types prettier --write ./src ./tests",
    "format:check": "cross-env NODE_OPTIONS=--experimental-strip-types prettier --check ./src ./tests",
    "format:staged": "cross-env NODE_OPTIONS=--experimental-strip-types lint-staged",
    "lint": "eslint .",
    "prepublishOnly": "pnpm build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kisiwu/storehouse-redis.git"
  },
  "keywords": [
    "storehouse",
    "redis"
  ],
  "author": "demingongo",
  "license": "MIT",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@redis/client": "^6.3.0",
    "@redis/json": "^6.3.0",
    "@redis/search": "^6.3.0",
    "@standard-schema/spec": "^1.1.0",
    "@storehouse/core": "^2.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "redis": "^6.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "typescript-eslint": "^8.71.2",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@storehouse/core": "^2.1.0",
    "redis": "^6.3.0"
  },
  "dependencies": {
    "@novice1/logger": "^1.6.1",
    "tslib": "^2.8.1"
  }
}